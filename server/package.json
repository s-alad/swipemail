{
  "name": "server",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "gen": "auth generate --config src/auth.ts --output src/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.28",
    "@googleapis/gmail": "^22.1.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "mailparser": "^3.15.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.28",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
